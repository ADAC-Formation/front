# API backend (injectée au BUILD par Vite, pas lue à l'exécution)
# Dev local : le back tourne sur le port 8080
# Prod (Docker) : même origine, nginx proxifie /api/ -> utiliser "/api"
VITE_API_URL=http://localhost:8080/api

# (Développement, optionnel) En attendant que le back envoie `inscriptionId` au stagiaire (Q13) :
# id de formation -> id réel d inscription du compte de test (voir docs/dev/README.md). Ignoré en production.
# VITE_DEV_INSCRIPTION_IDS={"101":7}
